 "$id": "memelab.predictive.forecast_result/1",
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "additionalProperties": false,
 "description": "Format only. A document that passes says nothing about accuracy. A probability appears only on FORECAST, finite in the display range, with a CALIBRATED SHADOW or VALIDATED_EXPERIMENTAL calibration reference; ABSTAIN carries named reasons and no number. Change control PI-D-070 added the condition CALIBRATION_AFTER_DECISION.",
