       }
      }
     },
     "then": {
      "properties": {
       "abstain_reasons": {
        "minItems": 1,
        "type": "array"
       },
       "probability": {
        "type": "null"
       },
       "uncertainty_interval": {
        "type": "null"
       }
      }
     }
    },
    {
