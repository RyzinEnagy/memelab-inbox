{
 "$defs": {
  "calibration_reference": {
   "additionalProperties": false,
   "properties": {
    "calibration_card_sha": {
     "pattern": "^[0-9a-f]{64}$",
     "type": "string"
    },
    "calibration_k": {
     "minimum": 20,
     "type": "integer"
    },
    "calibration_n": {
     "minimum": 100,
     "type": "integer"
    },
    "calibration_version": {
     "const": "calibration-1"
    },
    "holdout_k": {
     "minimum": 10,
     "type": "integer"
    },
    "holdout_n": {
     "minimum": 50,
     "type": "integer"
    },
    "level": {
     "enum": [
      "SHADOW",
      "VALIDATED_EXPERIMENTAL"
     ]
    },
    "method": {
     "enum": [
      "VENN_ABERS",
      "PLATT"
     ]
    },
    "passed": {
     "const": true
    },
    "status": {
     "const": "CALIBRATED"
    },
    "support_k": {
     "minimum": 0,
     "type": "integer"
    },
    "support_n": {
     "minimum": 20,
     "type": "integer"
    }
   },
