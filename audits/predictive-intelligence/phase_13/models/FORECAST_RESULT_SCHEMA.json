  "document": {
   "$ref": "#/$defs/document"
  },
  "record": {
   "$ref": "#/$defs/record"
  }
 },
 "required": [
  "document",
  "record"
 ],
 "title": "ForecastResult: a forecast/1 document and its abstention-1 record (Phase 13, PI-D-067)",
 "type": "object"
}
